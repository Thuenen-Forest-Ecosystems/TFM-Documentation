# Server configuration for the TFM Documentation site.
# Vite only exposes variables prefixed with VITE_ to the client.
# If a variable is missing everywhere, the code falls back to the remote server.
#
# Two ready-made configurations are committed to the repo:
#   .env.remote        → remote production server  (npm run docs:dev:remote)
#   .env.local-server  → local development stack   (npm run docs:dev:local)
#
# Optionally copy this file to .env (gitignored) as your personal default for
# plain `npm run docs:dev`. The dedicated scripts above take priority over .env.

VITE_SUPABASE_URL=https://ci.thuenen.de
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJyb2xlIjoiYW5vbiIsImlzcyI6InN1cGFiYXNlIiwiaWF0IjoxNzQ1NzkxMjAwLCJleHAiOjE5MDM1NTc2MDB9.hXiYlA_168hHZ6fk3zPgABQUpEcqkYRMzu0A5W5PtYU
VITE_REDIRECT_TO=https://thuenen-forest-ecosystems.github.io/TFM-Documentation
VITE_SYNC_URL=https://ci.thuenen.de/sync
